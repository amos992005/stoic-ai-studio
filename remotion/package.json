{
  "name": "stoic-demo-reel",
  "version": "1.0.0",
  "private": true,
  "description": "Code-first motion graphics DemoReel: Remotion + React/TS, rendered headless on CPU.",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "build": "remotion render src/index.ts DemoReel ../outputs/demo_reel.mp4 --browser=chrome-headless-shell --codec=h264 --pixel-format=yuv420p",
    "typecheck": "tsc --noEmit",
    "still": "remotion still src/index.ts DemoReel"
  },
  "dependencies": {
    "@remotion/cli": "4.0.547",
    "@remotion/fonts": "4.0.547",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.547"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "typescript": "5.9.2"
  }
}
