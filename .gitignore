# ---- Node / Remotion ----
node_modules/
remotion/build/
remotion/out/
*.tsbuildinfo

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---- Secrets ----
.env
.env.*

# ---- Generated output ----
# The pipeline produces these on every run. CI force-adds only the finished
# reel and its report so the branch always carries the current deliverable.
outputs/*
!outputs/.gitkeep
# Voiceover is synthesised in CI (and is a ~14 s MP3, not a source asset).
remotion/public/voiceover.mp3

# ---- Editor / OS noise ----
.DS_Store
.idea/
.vscode/
*.swp
