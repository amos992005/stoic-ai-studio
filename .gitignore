# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- Secrets: never commit Kaggle credentials ----
kaggle.json
.kaggle/
.env
.env.*

# ---- Generated by CI (only the curated artifacts are force-added) ----
# Raw model outputs are large; CI commits contact_sheet.png, metrics.json and
# build.log explicitly with `git add -f`, everything else stays out of git.
outputs/*
!outputs/.gitkeep

# ---- Editor / OS noise ----
.DS_Store
.idea/
.vscode/
*.swp

# Generated by the orchestrator at run time (regenerated on every push)
kaggle_kernel/kernel-metadata.json
preview_contact_sheet.png
venv/
.venv/

# Phase 2: generated kernel metadata + heavy model caches
kaggle_kernel_talking/kernel-metadata.json
_kokoro-v1.0.onnx
_voices-v1.0.bin
stoic_lipsync/
.kaggle_dataset/

# Phase 3: generated kernel metadata
# Regenerated at runtime from scripts/luca_v2/_vendor/ by fetch_instantid.py.
scripts/luca_v2/instantid_pipeline.py
kaggle_kernel_luca/kernel-metadata.json
# Staged by scripts/run_luca_job.py before `kaggle kernels push`; the sources
# live in scripts/luca_v2/ and stay the single source of truth.
kaggle_kernel_luca/generate_images.py
kaggle_kernel_luca/generate_video.py
kaggle_kernel_luca/fetch_instantid.py
kaggle_kernel_luca/instantid_pipeline.py
kaggle_kernel_luca/_vendor/
